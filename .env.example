# =====================================================================
#  Variables de entorno del backend. Copie este archivo a .env:
#      cp .env.example .env
#  y reemplace los valores marcados como CAMBIAR antes de usarlo fuera de local.
#  .env está en .gitignore: nunca versione secretos reales.
# =====================================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
# CAMBIAR
POSTGRES_PASSWORD=1234
POSTGRES_PORT=5432
DB_USERNAME=postgres
# CAMBIAR (igual a POSTGRES_PASSWORD)
DB_PASSWORD=1234
DB_POOL_SIZE=10
AUTH_DB_URL=jdbc:postgresql://postgres:5432/auth_db
POST_DB_URL=jdbc:postgresql://postgres:5432/post_db
FEED_DB_URL=jdbc:postgresql://postgres:5432/feed_db
FEED_R2DBC_URL=r2dbc:postgresql://postgres:5432/feed_db

# ---------- JWT ----------
# Mínimo 32 caracteres. Genere uno con:  openssl rand -base64 48
JWT_SECRET=CAMBIAR-este-secreto-local-de-al-menos-32-caracteres-2026
JWT_ISSUER=periferia-social-auth
JWT_EXPIRATION=PT1H
BCRYPT_STRENGTH=10

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICAS=1
KAFKA_TOPIC_USER_REGISTERED=social.user.registered.v1
KAFKA_TOPIC_POST_CREATED=social.post.created.v1
POST_SERVICE_CONSUMER_GROUP=post-service
FEED_PROJECTION_GROUP=feed-projection
FEED_BROADCAST_GROUP_PREFIX=feed-broadcast

# ---------- Outbox ----------
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# ---------- Seeder (usuarios de prueba: alice, bob, carol, david) ----------
SEED_ENABLED=true
SEED_DEFAULT_PASSWORD=Password123*

# ---------- Puertos ----------
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
POST_SERVICE_PORT=8082
FEED_SERVICE_PORT=8083

# ---------- API Gateway ----------
AUTH_SERVICE_URI=http://auth-service:8081
POST_SERVICE_URI=http://post-service:8082
FEED_SERVICE_URI=http://feed-service:8083
FEED_WEBSOCKET_URI=ws://feed-service:8083
# Orígenes permitidos (web local, Nginx del frontend, Capacitor iOS/Android)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost,http://localhost:8081,capacitor://localhost,https://localhost
GATEWAY_TIMEOUT=PT5S
GATEWAY_CB_OPEN_WAIT=PT15S
GATEWAY_CB_FAILURE_RATE=50
GATEWAY_RETRIES=2
GATEWAY_RETRY_BACKOFF=PT0.1S
# URL base que Swagger usa para "Try it out" (todas las llamadas pasan por el gateway)
OPENAPI_SERVER_URL=http://localhost:8080

# ---------- Tiempo real ----------
WS_HEARTBEAT_INTERVAL=PT25S
WS_SUBSCRIBER_BUFFER=256

# ---------- Observabilidad ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0
JAEGER_UI_PORT=16686
LOG_LEVEL_APP=INFO
